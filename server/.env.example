# 服务器配置
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# 数据库配置
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=videoflow_pro
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# JWT 配置
JWT_SECRET=your_jwt_secret_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# API Key 加密密钥（32字节）
ENCRYPTION_KEY=your_32_byte_encryption_key_here_must_be_32_chars

# Upload-Post 配置
UPLOAD_POST_API_ENDPOINT=https://api.upload-post.com/v1

# 文件存储（可选，后续配置）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=

# Redis（可选，用于任务队列）
# REDIS_HOST=localhost
# REDIS_PORT=6379

# 前端地址（CORS）
FRONTEND_URL=http://localhost:3000
